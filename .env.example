# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# The deployment under test.
BASE_URL=https://2set.com

# Treat this deployment as production. When true, every test that would WRITE
# data is skipped rather than run, because the target holds real patient records.
# Set to false only for a local or staging instance you are willing to dirty.
IS_PRODUCTION=true

# An account with broad access, used for read-only navigation and rendering tests.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# An account with NO extra grants, used to prove the API refuses it. Optional but
# valuable: it is the only way to test authorization rather than just assume it.
LIMITED_EMAIL=
LIMITED_PASSWORD=

# The published demo account, if one is configured. Read-only tests only.
DEMO_EMAIL=
DEMO_PASSWORD=

# Set true only if the target is NOT production and you accept data being created.
ALLOW_WRITES=false
